{
  "uid": "conexao-solidaria",
  "title": "Conexão Solidária — Observabilidade",
  "tags": ["hackathon", "conexao-solidaria"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Doações processadas pelo Worker",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(doacoes_processadas_total)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "short", "decimals": 0 } }
    },
    {
      "id": 2, "type": "stat", "title": "Total arrecadado (R$)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(doacoes_valor_processado_total)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "unit": "currencyBRL", "decimals": 2 } }
    },
    {
      "id": 3, "type": "stat", "title": "Reentregas ignoradas (idempotência)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(doacoes_duplicadas_ignoradas_total)", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" }, "unit": "short", "decimals": 0 } }
    },
    {
      "id": 4, "type": "stat", "title": "Mensagens aguardando em doacoes-recebidas",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rabbitmq_queue_messages{queue=\"doacoes-recebidas\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 100 } ] } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Requisições HTTP por segundo, por serviço",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (app) (rate(http_requests_received_total[1m]))", "legendFormat": "{{app}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "lineWidth": 2 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Latência HTTP p95, por serviço",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, app) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{app}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2 } } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Fluxo assíncrono: doações registradas (API) × processadas (Worker), por minuto",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(campanhas_doacoes_registradas_total[1m]))", "legendFormat": "registradas pela API", "refId": "A" },
        { "expr": "sum(increase(doacoes_processadas_total[1m]))", "legendFormat": "processadas pelo Worker", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 20, "lineWidth": 2 } } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Profundidade das filas do RabbitMQ",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rabbitmq_queue_messages{queue=~\"doacoes-recebidas|campanhas-atualizadas|.*\\.dlq\"}", "legendFormat": "{{queue}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 20, "lineWidth": 2 } } }
    },
    {
      "id": 9, "type": "timeseries", "title": "CPU por pod (cores)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"conexao-solidaria\", container!=\"\", container!=\"POD\"}[2m]))", "legendFormat": "{{pod}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3, "custom": { "fillOpacity": 10, "lineWidth": 1 } } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Memória por pod",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"conexao-solidaria\", container!=\"\", container!=\"POD\"})", "legendFormat": "{{pod}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "lineWidth": 1 } } }
    }
  ]
}
